<mvc:View controllerName="zsac.fiori.controller.ModelList" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" height="100%">
  <ScrollContainer height="100%" vertical="true">
    <VBox class="zsacPage">
      <Table id="table" items="{view>/items}" noDataText="No models yet" sticky="ColumnHeaders,HeaderToolbar">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="Modeller" level="H3"/>
            <ToolbarSpacer/>
            <SearchField width="14rem" liveChange=".onSearch" placeholder="Search models"/>
            <Button text="Create model" icon="sap-icon://add" type="Emphasized" press=".onCreate"/>
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="Name"/></Column>
          <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Dimensions"/></Column>
          <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Measures"/></Column>
          <Column minScreenWidth="Desktop" demandPopin="true"><Text text="Planning"/></Column>
          <Column minScreenWidth="Desktop" demandPopin="true"><Text text="Data source"/></Column>
          <Column hAlign="End" width="6rem"><Text text=""/></Column>
        </columns>
        <items>
          <ColumnListItem type="Navigation" press=".onOpen">
            <cells>
              <ObjectIdentifier title="{view>Name}" text="{view>ModelId} - {view>Description}"/>
              <Text text="{view>dims}"/>
              <Text text="{view>measures}"/>
              <ObjectStatus text="{= ${view>PlanningEnabled} ? 'Enabled' : 'Off'}" state="{= ${view>PlanningEnabled} ? 'Success' : 'None'}"/>
              <Text text="{view>DataSource}"/>
              <Button icon="sap-icon://delete" type="Transparent" press=".onDelete" tooltip="Delete"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </VBox>
  </ScrollContainer>
</mvc:View>
