<mvc:View controllerName="zsac.fiori.controller.DataActions" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" height="100%">
  <ScrollContainer height="100%" vertical="true">
    <VBox class="zsacPage">
      <IconTabBar id="tabs" expandable="false" applyContentPadding="false" select=".onTab">
        <items>
          <IconTabFilter key="actions" text="Data Actions" icon="sap-icon://workflow-tasks">
            <Table id="actionTable" items="{list>/items}" noDataText="No data actions yet. Create one to get started." growing="true" growingThreshold="50">
              <headerToolbar>
                <OverflowToolbar>
                  <SearchField width="16rem" placeholder="Search" liveChange=".onSearch"/>
                  <ToolbarSpacer/>
                  <Button text="Create" icon="sap-icon://add" type="Emphasized" press=".onNew"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="Name"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Model"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Steps"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Parameters"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="Last run"/></Column>
                <Column width="12rem" hAlign="End"><Text text=""/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onOpen">
                  <cells>
                    <ObjectIdentifier title="{list>Name}" text="{list>Description}"/>
                    <Text text="{list>ModelName}"/>
                    <Text text="{list>StepCount}"/>
                    <Text text="{list>ParamCount}"/>
                    <ObjectStatus text="{list>LastRunText}" state="{list>LastRunState}"/>
                    <HBox justifyContent="End">
                      <Button icon="sap-icon://play" tooltip="Run" type="Transparent" press=".onRunRow"/>
                      <Button icon="sap-icon://duplicate" tooltip="Duplicate" type="Transparent" press=".onDuplicateRow"/>
                      <Button icon="sap-icon://delete" tooltip="Delete" type="Transparent" press=".onDeleteRow"/>
                    </HBox>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
          <IconTabFilter key="runs" text="Run History" icon="sap-icon://history">
            <Table id="runTable" items="{runs>/items}" noDataText="Nothing has run yet." growing="true" growingThreshold="50">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="Job Monitor" level="H5"/>
                  <ToolbarSpacer/>
                  <Button icon="sap-icon://refresh" tooltip="Refresh" press=".onRefreshRuns"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column width="7rem"><Text text="Status"/></Column>
                <Column><Text text="Action"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Type"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Changed"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="Duration"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="User"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Started"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onRunDetail">
                  <cells>
                    <ObjectStatus text="{runs>StatusText}" state="{runs>StatusState}"/>
                    <ObjectIdentifier title="{runs>ActionName}" text="{runs>ParamsText}"/>
                    <Text text="{runs>KindText}"/>
                    <Text text="{runs>Changed}"/>
                    <Text text="{runs>DurationText}"/>
                    <Text text="{runs>User}"/>
                    <Text text="{runs>AtText}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </VBox>
  </ScrollContainer>
</mvc:View>
