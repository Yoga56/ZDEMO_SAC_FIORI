<mvc:View controllerName="zsac.fiori.controller.App"
  xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:tnt="sap.tnt" xmlns:core="sap.ui.core" xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" displayBlock="true" height="100%">
  <tnt:ToolPage id="toolPage" class="zsacShell" sideExpanded="false">
    <tnt:header>
      <tnt:ToolHeader>
        <Image src="https://upload.wikimedia.org/wikipedia/commons/5/59/SAP_2011_logo.svg" height="1.5rem" visible="false"/>
        <Title text="Analytics and Planning" level="H2" wrapping="false"/>
        <ToolbarSpacer/>
        <Text id="providerBadge" class="zsacProvider"/>
        <Button icon="sap-icon://refresh" type="Transparent" press=".onResetMock" tooltip="Reset sample data" id="resetBtn" visible="false"/>
        <Button id="bell" icon="sap-icon://bell" type="Transparent" press=".onBell" tooltip="Reminders" visible="false"/>
      </tnt:ToolHeader>
    </tnt:header>
    <tnt:mainContents>
      <NavContainer id="pages" defaultTransitionName="show"/>
    </tnt:mainContents>
  </tnt:ToolPage>
  <!-- the navigation is a floating button over the page (bottom left) that opens a floating menu, so there is no sliding bar and nothing to mistake for the SAP shell bar above -->
  <Button id="fab" class="zsacFab" icon="sap-icon://grid" type="Emphasized" press=".onToggleSide" tooltip="Navigation">
  <dependents>
  <Popover id="navMenu" class="zsacNavMenu" showHeader="false" showArrow="false" placement="Top" verticalScrolling="true" contentMinWidth="14rem">
    <List id="side" mode="SingleSelectMaster" selectionChange=".onNavSelect" includeItemInSelection="true">
      <StandardListItem title="Home" icon="sap-icon://home" type="Active" custom:key="home"/>
      <StandardListItem title="Files" icon="sap-icon://folder-full" type="Active" custom:key="files"/>
      <StandardListItem title="Stories" icon="sap-icon://business-objects-experience" type="Active" custom:key="stories"/>
      <StandardListItem title="Data Analyser" icon="sap-icon://pie-chart" type="Active" custom:key="analyser"/>
      <StandardListItem title="Datasets" icon="sap-icon://database" type="Active" custom:key="datasets"/>
      <StandardListItem title="Modeller" icon="sap-icon://dimension" type="Active" custom:key="modelers"/>
      <StandardListItem title="Planning" icon="sap-icon://projector" type="Active" custom:key="planning"/>
      <StandardListItem title="Data Actions" icon="sap-icon://workflow-tasks" type="Active" custom:key="dataactions"/>
      <StandardListItem title="Multi Actions" icon="sap-icon://process" type="Active" custom:key="multiactions"/>
      <StandardListItem title="Calendar" icon="sap-icon://calendar" type="Active" custom:key="calendar"/>
    </List>
  </Popover>
  </dependents>
  </Button>
</mvc:View>
