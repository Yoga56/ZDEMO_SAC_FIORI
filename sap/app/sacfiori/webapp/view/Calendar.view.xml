<mvc:View controllerName="zsac.fiori.controller.Calendar" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" height="100%">
  <Page showHeader="false" enableScrolling="false" class="sapUiNoContentPadding">
    <subHeader>
      <OverflowToolbar>
        <Title text="Calendar" level="H3"/>
        <SegmentedButton id="space" selectedKey="list" selectionChange=".onSpace">
          <items>
            <SegmentedButtonItem key="calendar" text="Calendar" icon="sap-icon://calendar"/>
            <SegmentedButtonItem key="list" text="List" icon="sap-icon://list"/>
          </items>
        </SegmentedButton>
        <ToolbarSeparator/>
        <MenuButton id="newMenu" icon="sap-icon://add" text="New" type="Emphasized"><menu><Menu id="newItems" itemSelected=".onNewItem"/></menu></MenuButton>
        <Button id="copy" icon="sap-icon://duplicate" tooltip="Copy the selected event" press=".onCopy" enabled="false"/>
        <Button id="del" icon="sap-icon://delete" tooltip="Delete the selected event" press=".onDelete" enabled="false"/>
        <Button icon="sap-icon://refresh" tooltip="Refresh" press=".onRefresh"/>
        <ToolbarSpacer/>
        <SearchField width="11rem" liveChange=".onSearch" placeholder="Search events"/>
        <Select id="statusFilter" width="9rem" change=".onStatusFilter"/>
        <ToggleButton id="mine" text="Mine" icon="sap-icon://person-placeholder" press=".onMine" tooltip="Only events you own, are assigned to or may view"/>
        <ToolbarSeparator/>
        <Button icon="sap-icon://navigation-left-arrow" press=".onPrev" tooltip="Earlier"/>
        <Text id="period" width="8rem" textAlign="Center"/>
        <Button icon="sap-icon://navigation-right-arrow" press=".onNext" tooltip="Later"/>
        <Button text="Today" press=".onToday"/>
        <SegmentedButton id="zoom" selectedKey="month" selectionChange=".onZoom">
          <items>
            <SegmentedButtonItem key="day" text="Day"/>
            <SegmentedButtonItem key="week" text="Week"/>
            <SegmentedButtonItem key="month" text="Month"/>
            <SegmentedButtonItem id="yearItem" key="year" text="Year"/>
          </items>
        </SegmentedButton>
      </OverflowToolbar>
    </subHeader>
    <content>
      <HBox class="zsacCalPage" renderType="Bare" height="100%">
        <ScrollContainer id="mainScroll" class="zsacCalMain" height="100%" width="100%" vertical="true" horizontal="true">
          <core:HTML id="main" content="&lt;div&gt;&lt;/div&gt;"/>
        </ScrollContainer>
        <VBox id="panel" class="zsacCalPanel" visible="false" renderType="Bare"/>
      </HBox>
    </content>
  </Page>
</mvc:View>
