<mvc:View controllerName="zsac.fiori.controller.Calendar" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" height="100%">
  <ScrollContainer height="100%" vertical="true">
    <VBox class="zsacPage">
      <Table id="table" items="{path: 'view>/items', sorter: [{path: 'month', group: true}, {path: 'DueDate'}], groupHeaderFactory: '.groupHeader'}" noDataText="No tasks" sticky="ColumnHeaders,HeaderToolbar">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="Planning Calendar" level="H3"/>
            <ToolbarSpacer/>
            <SegmentedButton selectedKey="ALL" selectionChange=".onFilter">
              <items>
                <SegmentedButtonItem key="ALL" text="All"/>
                <SegmentedButtonItem key="MINE" text="Mine"/>
                <SegmentedButtonItem key="OPEN" text="Open"/>
                <SegmentedButtonItem key="IN_REVIEW" text="In review"/>
              </items>
            </SegmentedButton>
            <Button text="New task" icon="sap-icon://add" type="Emphasized" press=".onNew"/>
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="Task"/></Column>
          <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Plan"/></Column>
          <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Assignee"/></Column>
          <Column width="7rem"><Text text="Due"/></Column>
          <Column width="8rem"><Text text="Status"/></Column>
          <Column hAlign="End" width="13rem"><Text text=""/></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <ObjectIdentifier title="{view>Title}" text="{view>Notes}"/>
              <Link text="{view>ModelId} / {view>VersionId}" press=".onOpenPlan"/>
              <Text text="{view>Assignee}"/>
              <ObjectStatus text="{view>DueDate}" state="{view>dueState}"/>
              <ObjectStatus text="{view>statusText}" state="{view>statusState}"/>
              <HBox justifyContent="End">
                <Button text="Submit" visible="{= ${view>Status} === 'OPEN'}" press=".onSubmit" type="Transparent"/>
                <Button text="Approve" visible="{= ${view>Status} === 'IN_REVIEW'}" press=".onApprove" type="Accept"/>
                <Button text="Reject" visible="{= ${view>Status} === 'IN_REVIEW'}" press=".onReject" type="Reject"/>
                <Button icon="sap-icon://delete" type="Transparent" press=".onDelete"/>
              </HBox>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </VBox>
  </ScrollContainer>
</mvc:View>
