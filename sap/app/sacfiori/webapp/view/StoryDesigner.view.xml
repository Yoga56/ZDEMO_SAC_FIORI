<mvc:View controllerName="zsac.fiori.controller.StoryDesigner" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:zd="zsac.lib.designer" xmlns:zp="zsac.lib.planning" height="100%">
  <Page showHeader="false" enableScrolling="false" class="sapUiNoContentPadding">
    <subHeader>
      <OverflowToolbar>
        <Button icon="sap-icon://nav-back" type="Transparent" press=".onNavBack"/>
        <Input id="name" width="16rem" change=".onName" visible="false"/>
        <Title id="title" level="H3"/>
        <Text id="dirty" class="zsacDirty"/>
        <Text id="access" class="zsacSub"/>
        <ToolbarSeparator/>
        <SegmentedButton id="mode" selectedKey="view" selectionChange=".onMode">
          <items>
            <SegmentedButtonItem key="view" icon="sap-icon://show" text="View"/>
            <SegmentedButtonItem key="edit" icon="sap-icon://edit" text="Edit"/>
          </items>
        </SegmentedButton>
        <ToolbarSeparator/>
        <SegmentedButton id="pages" selectionChange=".onPage"/>
        <Button id="addPage" icon="sap-icon://add" tooltip="Add page" press=".onAddPage" visible="false"/>
        <Button id="renamePage" icon="sap-icon://edit" tooltip="Rename page" press=".onRenamePage" visible="false"/>
        <Button id="deletePage" icon="sap-icon://delete" tooltip="Delete page" press=".onDeletePage" visible="false"/>
        <ToolbarSpacer/>
        <Button id="tidy" icon="sap-icon://arrow-top" text="Tidy up" tooltip="Move the widgets up to close the gaps. Arrow keys move the selected widget, Shift+arrows resize it." press=".onTidy" visible="false"/>
        <Button id="dup" icon="sap-icon://duplicate" text="Duplicate widget" press=".onDuplicateWidget" enabled="false" visible="false"/>
        <Button id="del" icon="sap-icon://delete" text="Remove widget" press=".onRemoveWidget" enabled="false" visible="false"/>
        <Button id="share" icon="sap-icon://share-2" text="Share" press=".onShare" visible="false"/>
        <Button id="publish" text="Publish" press=".onPublish" visible="false"/>
        <Button id="save" text="Save" type="Emphasized" press=".onSave"/>
      </OverflowToolbar>
    </subHeader>
    <content>
      <HBox class="zsacDesigner" renderType="Bare">
        <VBox id="palette" class="zsacPalette" renderType="Bare" visible="false"/>
        <ScrollContainer class="zsacStage" vertical="true" horizontal="false">
          <VBox>
            <zp:PlanToolbar id="plan" visible="false"/>
            <zd:StoryCanvas id="canvas" selectionChange=".onSelect" storyChange=".onStoryChange" pageChange=".onPageChanged"/>
          </VBox>
        </ScrollContainer>
        <ScrollContainer id="right" class="zsacRight" vertical="true" visible="false">
          <zd:BuilderPanel id="builder" change=".onBuilderChange"/>
        </ScrollContainer>
      </HBox>
    </content>
  </Page>
</mvc:View>
