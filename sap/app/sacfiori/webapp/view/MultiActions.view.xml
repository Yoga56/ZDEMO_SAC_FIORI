<mvc:View controllerName="zsac.fiori.controller.MultiActions" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" height="100%">
  <ScrollContainer height="100%" vertical="true">
    <VBox class="zsacPage">
      <HBox class="zsacTwoPane">
        <VBox class="zsacMaster">
          <List id="list" items="{list>/items}" mode="SingleSelectMaster" selectionChange=".onSelect" noDataText="No multi actions">
            <headerToolbar>
              <OverflowToolbar>
                <Title text="Multi Actions" level="H4"/>
                <ToolbarSpacer/>
                <Button icon="sap-icon://add" text="New" press=".onNew"/>
              </OverflowToolbar>
            </headerToolbar>
            <StandardListItem title="{list>Name}" description="{list>Description}" icon="sap-icon://process"/>
          </List>
        </VBox>
        <VBox class="zsacDetail" id="detail" visible="false">
          <OverflowToolbar style="Clear">
            <Title id="title" level="H3"/>
            <ToolbarSpacer/>
            <Button text="Run" icon="sap-icon://play" press=".onRun" type="Emphasized"/>
            <Button text="Save" icon="sap-icon://save" press=".onSave"/>
            <Button icon="sap-icon://delete" press=".onDelete" tooltip="Delete"/>
          </OverflowToolbar>
          <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
            <VBox class="sapUiSmallMarginEnd"><Label text="Name" required="true"/><Input id="name" width="16rem" change=".onHeader"/></VBox>
            <VBox><Label text="Description"/><Input id="desc" width="28rem" change=".onHeader"/></VBox>
          </HBox>
          <Title text="Steps (run in order; the first failing step stops the run)" level="H5" class="sapUiSmallMarginBottom"/>
          <VBox id="steps"/>
          <Button text="Add step" icon="sap-icon://add" press=".onAddStep" class="sapUiSmallMarginTop"/>
        </VBox>
      </HBox>
    </VBox>
  </ScrollContainer>
</mvc:View>
