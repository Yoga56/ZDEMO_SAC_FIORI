managed implementation in class ZBP_R_SAC_DATAACT unique;
strict ( 2 );

define behavior for ZR_SAC_DATAACT alias DataAction
persistent table zsac_dataact
lock master
authorization master ( global )
etag master LocalLastChangedAt
{
  field ( readonly )
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedAt;

  create;
  update;
  delete;
  association _Step { create; }
  action Execute parameter ZA_SAC_DA_PARAM result [1] ZA_SAC_RUN_RESULT;

  mapping for zsac_dataact
  {
    ActionId = action_id;
    ModelId = model_id;
    ActionName = action_name;
    Description = description;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZR_SAC_DASTEP alias DataActionStep
persistent table zsac_dastep
lock dependent by _DataAction
authorization dependent by _DataAction
etag dependent by _DataAction
{
  field ( readonly )
   ActionId,
   LocalLastChangedAt;

  // created through its parent
  update;
  delete;
  association _DataAction;

  mapping for zsac_dastep
  {
    ActionId = action_id;
    StepNo = step_no;
    StepType = step_type;
    SrcVersion = src_version;
    TgtVersion = tgt_version;
    FilterText = filter_text;
    Factor = factor;
    TargetDim = target_dim;
    TargetMembers = target_members;
    LocalLastChangedAt = local_last_changed_at;
  }
}
