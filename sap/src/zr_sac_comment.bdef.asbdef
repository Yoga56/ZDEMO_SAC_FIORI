managed implementation in class ZBP_R_SAC_COMMENT unique;
strict ( 2 );

define behavior for ZR_SAC_COMMENT alias CellComment
persistent table zsac_comment
lock master
authorization master ( global )
etag master LocalLastChangedAt
{
  field ( mandatory : create )
   CommentId;

  field ( readonly : update )
   CommentId;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedAt;

  create;
  update;
  delete;

  mapping for zsac_comment
  {
    CommentId = comment_id;
    ModelId = model_id;
    VersionId = version_id;
    Period = period;
    Measure = measure;
    DimsJson = dims_json;
    CommentText = comment_text;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
