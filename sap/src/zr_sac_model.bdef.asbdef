managed implementation in class ZBP_R_SAC_MODEL unique;
strict ( 2 );

define behavior for ZR_SAC_MODEL alias Model
persistent table zsac_model
lock master
authorization master ( instance )
etag master LocalLastChangedAt
{
  field ( mandatory : create )
   ModelId;

  field ( readonly : update )
   ModelId;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedAt,
   OwnerId,
   CurrentUser;

  create;
  update;
  delete;
  association _Dimension { create; }
  association _Measure { create; }
  validation CheckStructure on save { field ModelName; create; update; }
  determination SetOwner on modify { create; }

  mapping for zsac_model
  {
    ModelId = model_id;
    ModelName = model_name;
    Description = description;
    Currency = currency;
    PeriodFrom = period_from;
    PeriodTo = period_to;
    PlanningEnabled = planning_enabled;
    DataLocking = data_locking;
    DataAudit = data_audit;
    DataSource = data_source;
    SourceJson = source_json;
    OwnerId = owner_id;
    LockDefault = lock_default;
    LockJson = lock_json;
    ValidJson = valid_json;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZR_SAC_DIM alias Dimension
persistent table zsac_dim
lock dependent by _Model
authorization dependent by _Model
etag dependent by _Model
{
  field ( mandatory : create )
   DimId;

  field ( readonly : update )
   DimId;

  field ( readonly )
   ModelId,
   ChildChangedAt;

  // created through its parent
  update;
  delete;
  association _Model;

  mapping for zsac_dim
  {
    ModelId = model_id;
    DimId = dim_id;
    DimLabel = dim_label;
    Slot = slot;
    Members = members;
    DimType = dim_type;
    Attributes = attributes;
    Hierarchies = hierarchies;
    ChildChangedAt = local_last_changed_at;
  }
}

define behavior for ZR_SAC_MEASURE alias Measure
persistent table zsac_measure
lock dependent by _Model
authorization dependent by _Model
etag dependent by _Model
{
  field ( mandatory : create )
   MeasureId;

  field ( readonly : update )
   MeasureId;

  field ( readonly )
   ModelId,
   ChildChangedAt;

  // created through its parent
  update;
  delete;
  association _Model;

  mapping for zsac_measure
  {
    ModelId = model_id;
    MeasureId = measure_id;
    MeasureLabel = measure_label;
    Unit = unit;
    Aggregation = aggregation;
    DataType = data_type;
    UnitType = unit_type;
    Scale = scale;
    Decimals = decimals;
    ExceptionAgg = exception_agg;
    ExceptionDims = exception_dims;
    ChildChangedAt = local_last_changed_at;
  }
}
