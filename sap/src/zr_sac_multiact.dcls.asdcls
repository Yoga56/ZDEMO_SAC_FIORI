@EndUserText.label: 'Access control for multi action'
@MappingRole: true
define role ZR_SAC_MULTIACT
{
  grant select on ZR_SAC_MULTIACT
    where ( OwnerId ) = aspect user
       or OwnerId = ''
       or OwnerId = '*'
       or ( _ShareMe.Principal ) = aspect user
       or ( _ShareAll.Principal ) = '*';
}
