managed implementation in class ZBP_R_SAC_CALTASK unique;
strict ( 2 );

define behavior for ZR_SAC_CALTASK alias CalendarTask
persistent table zsac_caltask
lock master
authorization master ( instance )
etag master LocalLastChangedAt
{
  field ( mandatory : create )
   TaskId;

  field ( readonly : update )
   TaskId;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedAt,
   OwnerId,
   CurrentUser;

  create;
  update;
  delete;
  determination SetOwner on modify { create; }

  mapping for zsac_caltask
  {
    TaskId = task_id;
    Title = title;
    ModelId = model_id;
    VersionId = version_id;
    Assignee = assignee;
    DueDate = due_date;
    Status = status;
    Approver = approver;
    Notes = notes;
    EventType = event_type;
    ParentId = parent_id;
    StartDate = start_date;
    EndDate = end_date;
    Progress = progress;
    PeopleJson = people_json;
    FilesJson = files_json;
    ConfigJson = config_json;
    OwnerId = owner_id;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
